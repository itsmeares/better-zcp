# Dependencies
node_modules/

# Environment & Secrets (NEVER COMMIT)
.env

# Database (user data)
data/db.json
data/backups/
*.db

# Persistent map tile cache (grows large, regenerable from upstream)
data/map-tiles-cache/

# Build outputs
apps/panel-client/dist/
dist-exe/
server.cjs

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.code-workspace

# Release builds
release/
ZomboidControlPanel-linux.tar.gz
ZomboidControlPanel-windows.zip

# Backup files
*.bak

# Stray dev files
*.ipynb
lh-*.json
_artifacts/

# Per-machine data/log root override (absolute paths, never committed).
# Also written by the server test setup for the duration of a test run.
paths.config.json
data/*.lock

# Secrets relocated out of db.json (per-server RCON store, reset token)
data/*.secret
# Single-use admin password-reset token. The Settings recovery flow tells the
# operator to paste it from here, so it exists on real installs and is a live
# credential while unused. The secret list above enumerated members and missed
# this one; *.token covers the class rather than just the instance.
data/reset-token.txt
data/*.token
data/server-secrets/
