# Dependencies
node_modules/
client/node_modules/

# Environment & Secrets (NEVER COMMIT)
.env

# Database (user data)
data/db.json
data/backups/
*.db

# Persistent map tile cache (grows large, regenerable from upstream)
data/map-tiles-cache/

# Build outputs
client/dist/
dist-exe/
server.cjs

# Build & deploy scripts (internal tooling)
bundle-server.js
deploy*.ps1
release.ps1
nodemon.json

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.code-workspace

# Copilot instructions (internal dev context)
.github/copilot-instructions.md

# Release builds
release/
ZomboidControlPanel-linux.tar.gz
ZomboidControlPanel-windows.zip

# GitHub Releases are the canonical release notes
release-notes-*.md

# Backup files
*.bak

# Stray dev files
*.ipynb
lh-*.json
_artifacts/

# Per-machine data/log root override (absolute paths, never committed).
# Also written by the server test setup for the duration of a test run.
paths.config.json
data/*.lock

# Secrets relocated out of db.json (jwt.secret, *.secret, per-server RCON store)
data/jwt.secret
# Single-use admin password-reset token. The Settings recovery flow tells the
# operator to paste it from here, so it exists on real installs and is a live
# credential while unused. The secret list above enumerated members and missed
# this one; *.token covers the class rather than just the instance.
data/reset-token.txt
data/*.token
data/*.secret
data/server-secrets/

# Impeccable design-skill tooling (agent harness, not product code)
.agents/
.claude/
skills-lock.json

# scripts/ui-shot-tour.mjs output (regenerable; Screenshots/ is the tracked,
# hand-curated README gallery -- this is a disposable full-app baseline).
.ui-tour/
