{
  "schemaVersion": 1,
  "meta": {
    "id": "first-week-friendly",
    "name": "First Week Friendly",
    "description": "Eases new players into the apocalypse: fewer zombies, a slower infection, more loot, and double XP. Good for onboarding a group before ramping up difficulty.",
    "tags": ["beginner", "casual", "co-op"],
    "pzBuild": "42"
  },
  "sandboxVars": {
    "settings": {
      "Zombies": 5,
      "FoodLootNew": 1.6,
      "MedicalLootNew": 1.2,
      "WeaponLootNew": 1.2,
      "AmmoLootNew": 1.2,
      "OtherLootNew": 1.6,
      "HoursForLootRespawn": 72
    },
    "ZombieLore": {
      "Mortality": 6
    },
    "ZombieConfig": {
      "PopulationMultiplier": 0.4,
      "PopulationStartMultiplier": 0.6
    },
    "MultiplierConfig": {
      "Global": 2.0
    }
  },
  "serverIni": {
    "PauseEmpty": true
  },
  "iniExclusions": [
    "RCONPassword",
    "Password",
    "ServerName",
    "PublicName",
    "DefaultPort",
    "UDPPort",
    "RCONPort",
    "server_browser_announced_ip"
  ],
  "mods": [],
  "map": { "mapId": "Muldraugh, KY" },
  "difficulty": { "level": "beginner" }
}
